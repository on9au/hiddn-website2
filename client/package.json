    "@vitejs/plugin-react": "^4.3.1",
    "axios": "^1.7.7",
    "cross-env": "^7.0.3",
    "express": "^4.19.2",
    "fastify": "^4.28.1",
    "http-proxy-middleware": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-markdown": "^9.0.1",
    "serve": "^14.2.3",
    "sirv": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
